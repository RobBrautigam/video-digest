    },
    {
      "start": 71.97,
      "dur": 1.2,
      "text": "that can be carried from Earth"
    },
    {
      "start": 73.17,
      "dur": 1.73,
      "text": "billions of miles away."
    },
    {
      "start": 74.9,
      "dur": 1.3,
      "text": "And then for exoplanets,"
    },
    {
      "start": 76.2,
