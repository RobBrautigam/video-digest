      "text": "these are planets"
    },
    {
      "start": 76.9,
      "dur": 1.7,
      "text": "beyond our own solar system."
    },
    {
      "start": 78.6,
      "dur": 1.2,
      "text": "Really, what we're looking for"
    },
    {
      "start": 79.8,
      "dur": 1.87,
      "text": "there are very large magnitude"
    },
    {
      "start": 81.67,
      "dur": 1.83,
      "text": "signs of life that can be detectable"
    },
    {
      "start": 83.5,
      "dur": 1.17,
      "text": "through a telescope"
    },
    {
      "start": 84.67,
      "dur": 1.43,
      "text": "from many light-years away."
