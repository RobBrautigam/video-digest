    },
    {
      "start": 89.24,
      "dur": 2.03,
      "text": "or changes in surface color."
    },
    {
      "start": 91.27,
      "dur": 1.3,
      "text": "So any one of those things,"
    },
    {
      "start": 92.57,
      "dur": 1.43,
      "text": "if they rose to the suspicion"
